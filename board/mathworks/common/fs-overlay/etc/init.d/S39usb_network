#!/bin/sh
#
# Start the usb ethernet....
#

source /etc/bootvars.conf
USB_CONF=/mnt/usb_config

if [ "${_SYS_NETWORK_DISABLE}" == "true" ]; then
    echo -n "USB ethernet disabled..."
    exit 0
fi

create_system_files () {

	if [ -f "$USB_CONF" ]
    then
    source $USB_CONF
    fi
	
	#edit the udhcpd.conf and interfaces files only when following confition is satisfied
	#USB_MODE is defined in $USB_CONF which will be added by HDL Verifier APIs for board setup
	#Also check if the USB dr_mode is peripheral. In peripheral mode, /sys/class/udc is not empty
	#as it lists the USB Device Controller devices.
	
	if [ "$USB_MODE" == "EthernetDevice" ] && [ "$(ls -A /sys/class/udc | wc -l)" -ne 0 ]
	then 
		UDHCPD_CONF=/etc/udhcpd.conf
		IFAC=/etc/network/interfaces
		
		HOSTNAME=`fw_printenv -n hostname 2> /dev/null || cat /etc/hostname`
		echo $HOSTNAME > /etc/hostname
		NETMASK=`fw_printenv -n netmask 2> /dev/null || echo 255.255.255.0`
		

		### /etc/udhcpd.conf ###
		# echo > replaces the text in /etc/udhcpd.conf
		echo "start $USB_IPADDR_HOST" > $UDHCPD_CONF
		echo "end $USB_IPADDR_HOST" >> $UDHCPD_CONF
		echo "interface usb0" >> $UDHCPD_CONF
		echo "option subnet $NETMASK" >> $UDHCPD_CONF

		### /etc/network/interfaces ###
		echo -e "auto usb0\n""iface usb0 inet static" >> $IFAC
		echo -e "\taddress $USB_IPADDR_TARGET\n""\tnetmask $NETMASK\n" >> $IFAC
	else
		exit 0
	fi
	}

case "$1" in
  start)
 	echo "Starting USB Ethernet..."
	create_system_files
	/sbin/modprobe -q g_ether
	;;
  stop)
	echo "Stopping USB Ethernet..."
	/sbin/rmmod g_ether 2>/dev/null
	;;
  restart|reload)
	"$0" stop
	"$0" start
	;;
  *)
	echo "Usage: $0 {start|stop|restart}"
	exit 1
esac

exit $?

